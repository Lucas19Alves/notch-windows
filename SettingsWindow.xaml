<Window x:Class="NotchApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" Width="480" Height="720" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="Black" Foreground="White"
        FontFamily="{StaticResource Text}" FontSize="14">
  <Window.Resources>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="16,26,0,7"/>
    </Style>
    <Style x:Key="Footnote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="16,7,16,0"/>
    </Style>
    <Style x:Key="GroupBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Group}"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#2C2C2E"/>
      <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>
    <Style x:Key="RowGrid" TargetType="Grid">
      <Setter Property="Margin" Value="16,0,12,0"/>
      <Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style x:Key="MiniRound" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="13" Background="#2C2C2E">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3A3A3C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel Margin="20,8,20,32" MaxWidth="600">

      <StackPanel HorizontalAlignment="Center" Margin="0,16,0,0">
        <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#3A3A3C" Offset="0"/>
              <GradientStop Color="#1C1C1E" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border Width="38" Height="13" CornerRadius="6.5" Background="Black" VerticalAlignment="Top" Margin="0,11,0,0"/>
        </Border>
        <TextBlock Text="Notch" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="Sua ilha dinâmica no topo do Windows" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
      </StackPanel>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Comportamento"/>
      <Border Style="{StaticResource GroupBox}">
        <StackPanel>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Animações"/>
            <ToggleButton x:Name="AnimationsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Esconder automaticamente"/>
            <ToggleButton x:Name="AutoHideSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid x:Name="DelayRow" Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Esconder depois de"/>
            <Border Background="#2C2C2E" CornerRadius="9" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Delay2" Style="{StaticResource Segment}" GroupName="delay" Content="2 s" Click="Changed_Click"/>
                <RadioButton x:Name="Delay4" Style="{StaticResource Segment}" GroupName="delay" Content="4 s" Click="Changed_Click"/>
                <RadioButton x:Name="Delay8" Style="{StaticResource Segment}" GroupName="delay" Content="8 s" Click="Changed_Click"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Manter visível com música tocando"/>
            <ToggleButton x:Name="KeepPlayingSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Abrir ao passar o mouse"/>
            <ToggleButton x:Name="HoverSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Esconder em jogos e vídeos em tela cheia"/>
            <ToggleButton x:Name="FullscreenSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Style="{StaticResource Footnote}" Text="Escondida, a ilha volta quando você leva o mouse ao topo da tela ou quando algo acontece."/>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Avisos na ilha"/>
      <Border Style="{StaticResource GroupBox}">
        <StackPanel>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Notificações ao chegar"/>
            <ToggleButton x:Name="BannersSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Volume e brilho"/>
            <ToggleButton x:Name="HudSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Música nova"/>
            <ToggleButton x:Name="TrackSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Fones e aparelhos Bluetooth"/>
            <ToggleButton x:Name="DevicesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Caps Lock, microfone, Foco e bateria fraca"/>
            <ToggleButton x:Name="AlertsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Tamanho da ilha"/>
      <Border Style="{StaticResource GroupBox}">
        <Grid Style="{StaticResource RowGrid}">
          <TextBlock Style="{StaticResource Label}" Text="Tamanho"/>
          <Border Background="#2C2C2E" CornerRadius="9" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Size85" Style="{StaticResource Segment}" GroupName="size" Content="Pequeno" Click="Changed_Click"/>
              <RadioButton x:Name="Size92" Style="{StaticResource Segment}" GroupName="size" Content="Médio" Click="Changed_Click"/>
              <RadioButton x:Name="Size100" Style="{StaticResource Segment}" GroupName="size" Content="Padrão" Click="Changed_Click"/>
              <RadioButton x:Name="Size110" Style="{StaticResource Segment}" GroupName="size" Content="Grande" Click="Changed_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Central"/>
      <Border Style="{StaticResource GroupBox}">
        <StackPanel x:Name="BlocksList"/>
      </Border>
      <TextBlock Style="{StaticResource Footnote}"
                 Text="Use as setas para mudar a ordem. Timer, notificações, música e arquivos só aparecem quando têm algo para mostrar."/>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Claude"/>
      <Border Style="{StaticResource GroupBox}">
        <Grid Style="{StaticResource RowGrid}">
          <TextBlock Style="{StaticResource Label}" Text="Mostrar limites de uso"/>
          <ToggleButton x:Name="AiSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
        </Grid>
      </Border>
      <TextBlock x:Name="AiNote" Style="{StaticResource Footnote}"
                 Text="Mostra quanto da sessão de 5 horas e da semana do seu plano já foi usado. Usa o login do Claude Code deste computador e só conversa com a Anthropic."/>

      <TextBlock Style="{StaticResource GroupTitle}" Text="Sistema"/>
      <Border Style="{StaticResource GroupBox}">
        <StackPanel>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Abrir com o Windows"/>
            <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Remover a barra de tarefas"/>
            <ToggleButton x:Name="RemoveTaskbarSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Grid x:Name="AutoHideRow" Style="{StaticResource RowGrid}">
            <TextBlock Style="{StaticResource Label}" Text="Ocultar a barra de tarefas"/>
            <ToggleButton x:Name="TaskbarSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Changed_Click"/>
          </Grid>
          <Border Style="{StaticResource Sep}"/>
          <Button Style="{StaticResource Row}" Click="NotifAccess_Click">
            <Grid>
              <TextBlock Text="Acesso às notificações" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="NotifStatus" Foreground="{StaticResource Secondary}" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#5A5A5E" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GroupBox}" Margin="0,26,0,0">
        <Button Style="{StaticResource Row}" HorizontalContentAlignment="Center" Click="Quit_Click">
          <TextBlock Text="Fechar o Notch" Foreground="{StaticResource Red}"/>
        </Button>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
